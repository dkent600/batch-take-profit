{
  "extends": [
    "stylelint-config-standard"
  ],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "plugin"
        ]
      }
    ],
    "import-notation": null,
    "at-rule-empty-line-before": [
      "always",
      {
        "except": [
          "after-same-name",
          "first-nested"
        ],
        "ignore": [
          "after-comment"
        ]
      }
    ]
  }
}